# The supported offline example and tests require no environment variables.
# Do not put credentials, wallet material, or account data in this file.

# Engine Configuration
MIN_PROFIT_THRESHOLD=1.0
MAX_TOTAL_PRICE_THRESHOLD=0.98
REFRESH_INTERVAL=60
FEE_RATE_BPS=0
SLIPPAGE_BPS=0

# Feature Flags
ENABLE_CROSS_PLATFORM=true
ENABLE_INTRA_PLATFORM=true
